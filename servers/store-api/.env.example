# Environment: dev, staging, production
ENV=dev

# Server configuration
HOST=0.0.0.0
PORT=8080

# Database
DATABASE_URL=postgres://user:password@localhost:5432/store_api_dev
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Auth
JWT_SECRET=your-secret-key-change-in-production

# Logging
LOG_LEVEL=debug

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
