# Port the API listens on (localhost). Optional, default 5555.
PORT=5555

# Neon Postgres. DATABASE_URL is required to start the API.
# Pooled connection string (host has -pooler). App runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct connection string. Needed for db:migrate / db:studio.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
SEED_ALLOWED_HOST=ep-example-pooler.REGION.aws.neon.tech

# Offline alternative: `docker compose up -d` at the repo root, then use these two instead of the Neon ones.
# If host port 5432 is taken, set HUSH_DB_PORT (e.g. 55432) when running compose and change the port below.
# DATABASE_URL=postgresql://hush:hush_local_dev_only@localhost:5432/hush
# DATABASE_URL_UNPOOLED=postgresql://hush:hush_local_dev_only@localhost:5432/hush

# Voyage AI embeddings (https://www.voyageai.com). Optional for the API; required by `pnpm ingest` (embeds chunks).
VOYAGE_API_KEY=

# Anthropic (https://www.anthropic.com). Optional for the API to start; required for chat answers.
ANTHROPIC_API_KEY=
# Model for chat answers. Optional, default claude-haiku-5-5.
ANTHROPIC_MODEL=claude-haiku-5-5

# Requests per minute on POST /chat. Both optional.
# Per user id. Default 10.
CHAT_RATE_LIMIT_PER_USER=10
# Per client IP. Default 30.
CHAT_RATE_LIMIT_PER_IP=30
