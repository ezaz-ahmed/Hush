# Port the API listens on (localhost). Optional, default 5555.
PORT=5555

# Neon Postgres. DATABASE_URL is required to start the API.
# Pooled connection string (host has -pooler). App runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct connection string. Needed for db:migrate / db:studio.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
SEED_ALLOWED_HOST=ep-example-pooler.REGION.aws.neon.tech
