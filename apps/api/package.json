{
  "name": "@hush/api",
  "private": true,
  "type": "module",
  "dependencies": {
    "@hush/shared": "workspace:*",
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-fastify": "12.5.1",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js)",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:coverage": "vitest run --dir src --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/database/run-seed.ts"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.1",
    "@swc/core": "1.16.22",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "unplugin-swc": "2.0.0"
  }
}
